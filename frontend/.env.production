# Used by `npm run build` for the Firebase Hosting deploy. Firebase Hosting
# rewrites can only proxy to Cloud Run/Cloud Functions, not an arbitrary
# external host, so PythonAnywhere needs its full URL baked in here as a
# genuine cross-origin API call (CORS(app) in backend/app/__init__.py
# already allows any origin, so this works without further backend changes).
VITE_API_URL=https://REPLACE_WITH_YOUR_USERNAME.pythonanywhere.com/api
