# Copy this file to .env in the backend/ directory and fill in real values.
# .env is loaded automatically on startup (see app/__init__.py).

# JWT signing secret -- change this in production
JWT_SECRET_KEY=your-secret-key-change-in-production

# Google OAuth Client ID, for "Sign in with Google" (see docs/GOOGLE_LOGIN_SETUP.md)
GOOGLE_CLIENT_ID=

# --- Production only (Cloud Run + Cloud SQL) ---
# Set these as Cloud Run environment variables / secrets, not in a committed
# .env file. Either set DATABASE_URL directly (any reachable Postgres), or
# set DB_USER/DB_PASS/DB_NAME/INSTANCE_CONNECTION_NAME and the app builds the
# Cloud SQL Unix-socket URL itself -- see app/__init__.py:_build_production_database_uri.
DATABASE_URL=
DB_USER=
DB_PASS=
DB_NAME=
INSTANCE_CONNECTION_NAME=
