# Secrets -- never commit real values, only .env.example files
backend/.env
frontend/.env
.env

# Python
venv/
__pycache__/
*.pyc
*.pyo

# Databases -- contains real student names/emails; never committed
backend/instance/
*.db

# Frontend build output / deps
frontend/node_modules/
frontend/dist/

# Firebase CLI local deploy cache
.firebase/

# Android/Capacitor build output (android/ project itself is committed)
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
frontend/android/capacitor-cordova-android-plugins/build/
frontend/android/local.properties

# Editors
.idea/
